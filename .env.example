# ==============================================================================
# PARTSPILOT: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your actual credentials.
# Never commit .env or real secret keys to source control.
# ==============================================================================

# Application Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Neon Serverless Postgres)
# DATABASE_URL uses the pooled connection string (with -pooler) for server runtime queries
DATABASE_URL=""
# DIRECT_URL uses the direct connection string (no pooler) for Prisma schema migrations
DIRECT_URL=""

# Google Gemini Multimodal API (Phase 3)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# Must be kept strictly server-side (no NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# PayPal REST API v2 Sandbox Credentials (Phase 5)
# Obtain from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Public client ID is safe for PayPal JS SDK on frontend:
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# Secret key is STRICTLY SERVER-SIDE:
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""
