# ==============================================================================
# PARTSPILOT: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your actual credentials.
# Never commit .env or real secret keys to source control.
# ==============================================================================

# Application Runtime & Public Domain URL
# In production on Render, set this to your HTTPS service URL (e.g. https://partspilot.onrender.com)
NODE_ENV="production"
APP_URL="https://partspilot.onrender.com"
NEXT_PUBLIC_APP_URL="https://partspilot.onrender.com"

# PostgreSQL Database (Neon Serverless Postgres)
# DATABASE_URL: Pooled connection string (-pooler) for server runtime queries
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct connection string (without -pooler) for Prisma schema migrations
DIRECT_URL="postgresql://username:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Google Gemini Multimodal API (Phase 3)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# Must be kept strictly server-side (never prefixed with NEXT_PUBLIC_)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyPlaceholder"
GEMINI_MODEL="gemini-3.5-flash"

# PayPal REST API v2 Sandbox Credentials (Phase 5)
# Obtain from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Server-side PayPal Client ID & Secret:
PAYPAL_CLIENT_ID="YourPayPalSandboxClientIdPlaceholder"
PAYPAL_CLIENT_SECRET="YourPayPalSandboxClientSecretPlaceholder"
# Public Client ID used by PayPal JS SDK on the browser:
NEXT_PUBLIC_PAYPAL_CLIENT_ID="YourPayPalSandboxClientIdPlaceholder"
# PayPal REST API endpoint (Sandbox for testing, NEVER live credentials):
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
# PayPal Webhook ID registered for /api/paypal/webhook:
PAYPAL_WEBHOOK_ID="YourPayPalWebhookIdPlaceholder"

# Security & Rate Limiting Salt
RATE_LIMIT_SALT="partspilot-production-salt-placeholder-replace-with-random"
